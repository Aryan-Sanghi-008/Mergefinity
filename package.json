{
  "name": "mergefinity",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "test:engine": "jest --coverage --collectCoverageFrom='src/engine/**/*.ts' --coveragePathIgnorePatterns='\\.test\\.ts$|index\\.ts$'",
    "engine:smoke": "ts-node -P tsconfig.engine.json -r tsconfig-paths/register scripts/engine-smoke.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "^57.0.7",
    "expo-audio": "~57.0.3",
    "expo-constants": "~57.0.6",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-keep-awake": "^57.0.1",
    "expo-linking": "~57.0.3",
    "expo-router": "~57.0.7",
    "expo-splash-screen": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-store-review": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-worklets": "0.10.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^26.1.1",
    "@types/react": "~19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.46.0",
    "@typescript-eslint/parser": "^8.46.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-preset-expo": "~57.0.3",
    "eslint": "^9.39.0",
    "eslint-config-expo": "~57.0.0",
    "eslint-plugin-import": "^2.32.0",
    "husky": "^9.1.7",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.2",
    "prettier": "^3.6.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest/setup.js"
    ],
    "testMatch": [
      "**/__tests__/**/*.[jt]s?(x)",
      "**/?(*.)+(spec|test).[jt]s?(x)"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "\\.wav$": "<rootDir>/jest/assetMock.js"
    },
    "collectCoverageFrom": [
      "src/engine/**/*.ts",
      "!src/engine/**/*.test.ts",
      "!src/engine/index.ts",
      "src/store/**/*.ts",
      "!src/store/**/*.test.ts",
      "!src/store/index.ts",
      "!src/store/middleware/**"
    ],
    "coverageThreshold": {
      "src/engine/": {
        "statements": 100,
        "branches": 100,
        "functions": 100,
        "lines": 100
      },
      "src/store/": {
        "statements": 85,
        "branches": 55,
        "functions": 85,
        "lines": 85
      }
    }
  }
}
